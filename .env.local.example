# Baton war-room env template. Placeholder names only — no secrets in files.
# Server-only: MOSS_PROJECT_KEY / LIVEBLOCKS_SECRET_KEY must never use NEXT_PUBLIC_*.

# Postgres via Neon/Vercel Marketplace (wired by the DB task — not this scaffold).
DATABASE_URL=your-pooled-neon-url-here
DATABASE_URL_UNPOOLED=your-unpooled-neon-url-here

# Moss (W2 owns provisioning; single index discipline).
MOSS_PROJECT_ID=your-moss-project-id
MOSS_PROJECT_KEY=your-moss-project-key
MOSS_INDEX_NAME=war-room-seed

# Liveblocks (W1 provision).
LIVEBLOCKS_SECRET_KEY=your-liveblocks-secret-key

# Gemini (G1 pacing: 1 req/6s). Prefer Vertex service-account auth when available.
GOOGLE_GENERATIVE_AI_API_KEY=
# Vertex AI (optional, preferred for live generation; needs billing on the GCP project):
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json (local only)
# GOOGLE_SERVICE_ACCOUNT_JSON=<raw-or-base64 service-account JSON> (Vercel prod)
# GOOGLE_VERTEX_PROJECT=your-gcp-project-id
# GOOGLE_VERTEX_LOCATION=us-central1

# Feature flags / tuning.
DISABLE_LLM=0
RECONCILER_INTERVAL_MS=300000
CO_SIGN_WINDOW_MS=600000
# Test overrides (T5): RECONCILER_INTERVAL_MS=5000 CO_SIGN_WINDOW_MS=60000

# Neon Auth (Wave 0 T1: @neondatabase/auth@0.5.0-beta EXACT).
NEON_AUTH_BASE_URL=your-neon-auth-base-url
NEON_AUTH_COOKIE_SECRET=your-neon-auth-cookie-secret
